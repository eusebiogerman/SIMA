<Window x:Class="SIMA.Presentation.Views.Wcategory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:SIMA.Templates"
        mc:Ignorable="d"
        Title="Category Management" 
        Height="710" 
        Width="560"
        Background="#F5F5F5"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Closing="Window_Closing" Loaded="Window_Loaded" Initialized="Window_Initialized">

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Style="{StaticResource SectionBorder}"
                Margin="0,0,0,0">

            <StackPanel Grid.Row="1" >
                <StackPanel>
                    <TextBlock Text="CATEGORY MANAGMENT" 
                               Style="{StaticResource Titleselection}"
                               TextAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="FormCategory">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="ID:" 
                           FontWeight="SemiBold" 
                           BorderThickness="0"
                           Margin="30,0,45,0"/>
                        <Label Content="Name:" 
                           FontWeight="SemiBold" 
                           BorderThickness="0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding IdCategory}"    
                     Name="txtIdCategory" 
                     Width="100"
                     Padding="2" 
                     Background="#F0F0F0"/>

                        <TextBox Text="{Binding Name, 
                            UpdateSourceTrigger=PropertyChanged, 
                            ValidatesOnNotifyDataErrors=True}"    
                    Name="txtName" 
                     Width="320"
                     Padding="5" 
                     Background="#F0F0F0">
                            <TextBox.Resources>
                                <ControlTemplate x:Key="NameErrorTemplate">
                                    <StackPanel>
                                        <AdornedElementPlaceholder Name="placeholder"/>
                                        <TextBlock Text="{Binding ElementName=placeholder, 
                           Path=AdornedElement.(Validation.Errors)[0].ErrorContent}" 
                           Foreground="Red" FontSize="10"/>
                                    </StackPanel>
                                </ControlTemplate>
                            </TextBox.Resources>

                            <Validation.ErrorTemplate>
                                <StaticResource ResourceKey="NameErrorTemplate"/>
                            </Validation.ErrorTemplate>
                        </TextBox>
                        <Button Name="btnsSaveCategory" 
                                Content="&#x1F4BE; Save" 
                                Style="{StaticResource CommunButton}"
                                Background="#377d0c"
                                Foreground="White"
                                Click="btnsSaveCategory_Click" />

                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" 
                Style="{StaticResource SectionBorder}" 
                Margin="0,0,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Search:" 
                           FontWeight="SemiBold" 
                           Margin="0,0,10,0"
                           Foreground="#333333"
                           VerticalAlignment="Center"/>


                <TextBox Text="{Binding Name, 
                            UpdateSourceTrigger=PropertyChanged, 
                            ValidatesOnNotifyDataErrors=True}"    
                    Name="txtSearch" 
                     Width="430"
                     Height="35" 
                     Padding="5" 
                     Background="#F0F0F0" TextChanged="txtSearch_TextChanged"/>
            </StackPanel>


        </Border>
        <Border Grid.Row="2" 
                    Style="{StaticResource SectionBorder}"
                    Margin="0,0,0,10">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock x:Name="txtResults" 
                               Text="📊 Show 12 products found" 
                               FontSize="12" 
                               FontWeight="SemiBold"
                               Foreground="#333333"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="3" 
                    Style="{StaticResource SectionBorder}"
                    Padding="0">
            <ListView x:Name="gridProducts" 
                          Background="Transparent"
                          BorderThickness="0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Width="auto"
                          Height="335" 
                          VerticalAlignment="Top"
                          Cursor="Hand"
                          ItemsSource="{Binding Categorys}" >

                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding IdCategory}" 
                                                   Margin="10,0" 
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Name" Width="300">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <TextBlock Text="{Binding Icono}" 
                                                       FontSize="16" 
                                                       Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" 
                                                       VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Action" Width="auto">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Style="{StaticResource GridButtonPanel}">
                                        <Button Style="{StaticResource GridButtonEdit}"
                                                        Click="btnUpdate_Click"/>
                                        <Button Style="{StaticResource GridButtonRemove}"
                                                        Click="btnRemove_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
        <Border Grid.Row="4" >
            <ctrl:PageNavigation 
                x:Name="pageControl"
                PageComboboxChanged ="PageNavigation_SelectionChanged"
                PreviousClick ="PagePrevious_Click"
                NextClick="PageNext_Click"/>
        </Border>
        <Border Grid.Row="5" 
                Style="{StaticResource SectionBorder}" 
                Margin="0,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" 
                    Style="{StaticResource ShortButtonStackPanel}">

                    <Button Name="btnNewStock" 
                            Content="➕ New" 
                            Style="{StaticResource ShortButtonPanel}"        
                            Margin="0,0,0,0"
                            Background="#5069AA"
                            Foreground="White"                    
                            Click="btnNewStock_Click" />
                </StackPanel>

                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right">
                    <Button Name="btnsClear" 
                            Content="Clear" 
                            Style="{StaticResource ShortButtonPanel}"
                            Click="btnsClear_Click" />

                    <Button Name="btnsClose" 
                            Content="Close" 
                            Style="{StaticResource ShortButtonPanel}"  
                            Margin="5,0,10,0"
                            Click="btnsClose_Click" />
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel>
            <Ellipse x:Name="wloading" Width="50" Height="50" Stroke="DodgerBlue" StrokeThickness="5" 
         StrokeDashArray="3, 1" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="noFreezeRotate" Angle="0" />
                </Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="noFreezeRotate"
                                     Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:1"
                                     RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
        </StackPanel>
    </Grid>
</Window> 