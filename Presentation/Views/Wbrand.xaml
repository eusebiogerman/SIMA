<Window x:Class="SIMA.Presentation.Views.Wbrand"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:SIMA.Templates"
        mc:Ignorable="d"
        Title="Brand Management" 
        Background="#F5F5F5"
        WindowStartupLocation="CenterOwner"
        Closing="Window_Closing" 
        Loaded="Window_Loaded" 
        Initialized="Window_Initialized" SizeChanged="Window_SizeChanged">


    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" 
                Style="{StaticResource SectionBorder}">
                <StackPanel >
                    <TextBlock Text="BRAND MANAGMENT" 
                               Style="{StaticResource Titleselection}"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" 
                x:Name="FormBrand"
                Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <StackPanel>
                        <StackPanel Style="{StaticResource PanelFields}">
                            <Label Content="ID:" 
                               Margin="5,0,37,0"
                               Style="{StaticResource LabelFields}"/>
                            <TextBox Name="txtIdBrand" 
                                 Width="100"
                                 Height="25"   
                                 Background="#F0F0F0"
                                 IsReadOnly="True"/>
                        </StackPanel>
                        <StackPanel  Style="{StaticResource PanelFields}">
                            <Label Content="Category:" 
                               Margin="5,0,0,0"
                               Style="{StaticResource LabelFields}"/>
                            <ctrl:LovTextBox x:Name="cmbCategory"
                                         ItemsSource="{Binding Category}"
                                         DisplayMemberPath="Value"
                                         SelectedValuePath="Id"
                                         SelectedIndex="0"
                                         Width="300" 
                                         Height="25" 
                                         FontSize="14"
                                         BorderBrush="#CCCCCC"
                                         LovTextBoxChanged="cmbCategory_SelectionChanged"/>

                            <Label Content="Product:" 
                               Margin="5,0,0,0"
                               Style="{StaticResource LabelFields}"/>
                            <ctrl:LovTextBox x:Name="cmbPropduct"
                                         ItemsSource="{Binding Product}"
                                         DisplayMemberPath="Value"
                                         SelectedValuePath="Id"
                                         SelectedIndex="0"
                                         Width="300" 
                                         Height="25" 
                                         FontSize="14"
                                         BorderBrush="#CCCCCC"/>
                        </StackPanel>
                        <StackPanel  Style="{StaticResource PanelFields}">
                            <Label Content="Name:" 
                               Margin="5,0,17,0"
                               Style="{StaticResource LabelFields}"/>

                            <TextBox Text="{Binding Name, 
                            UpdateSourceTrigger=PropertyChanged, 
                            ValidatesOnNotifyDataErrors=True}" 
                             Name="txtName" 
                             Width="400"
                             Height="25"    
                             Background="#F0F0F0">
                                <TextBox.Resources>
                                    <ControlTemplate x:Key="NameErrorTemplate">
                                        <StackPanel>
                                            <AdornedElementPlaceholder Name="placeholder"/>
                                            <TextBlock Text="{Binding ElementName=placeholder, 
                           Path=AdornedElement.(Validation.Errors)[0].ErrorContent}" 
                           Foreground="Red" FontSize="10"/>
                                        </StackPanel>
                                    </ControlTemplate>
                                </TextBox.Resources>

                                <Validation.ErrorTemplate>
                                    <StaticResource ResourceKey="NameErrorTemplate"/>
                                </Validation.ErrorTemplate>
                            </TextBox>
                        </StackPanel>
                        <StackPanel  Style="{StaticResource PanelFields}">
                            <Label Content="Price:" 
                               Margin="5,0,24,0"
                               Style="{StaticResource LabelFields}"/>

                            <TextBox Text="{Binding Price, 
                            UpdateSourceTrigger=PropertyChanged, 
                            ValidatesOnNotifyDataErrors=True}" 
                             Name="txtPrice" 
                             Width="150"
                             Height="25"    
                             Background="#F0F0F0">
                                <TextBox.Resources>
                                    <ControlTemplate x:Key="NameErrorTemplate">
                                        <StackPanel>
                                            <AdornedElementPlaceholder Name="placeholder"/>
                                            <TextBlock Text="{Binding ElementName=placeholder, 
                           Path=AdornedElement.(Validation.Errors)[0].ErrorContent}" 
                           Foreground="Red" FontSize="10"/>
                                        </StackPanel>
                                    </ControlTemplate>
                                </TextBox.Resources>

                                <Validation.ErrorTemplate>
                                    <StaticResource ResourceKey="NameErrorTemplate"/>
                                </Validation.ErrorTemplate>
                            </TextBox>
                            <Button Name="btnsSaveBrand" 
                                Content="&#x1F4BE; Save" 
                                Style="{StaticResource CommunButton}"
                                Background="#377d0c"
                                Foreground="White"
                                Click="btnsSaveBrand_Click" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" 
                Style="{StaticResource SectionBorder}">
                <StackPanel Grid.Row="0" 
                        Grid.Column="0"
                        Orientation="Horizontal">
                    <TextBlock Text="Search:" 
                           FontWeight="SemiBold" 
                           Margin="10,0,18,0"
                           Foreground="#333333"
                           VerticalAlignment="Center"/>
                    <TextBox Name="txtSearch" 
                         Width="430"
                         Height="35" 
                         Padding="5" 
                         Background="#F0F0F0" 
                         TextChanged="txtSearch_TextChanged"/>
                </StackPanel>


            </Border>
            <Border Grid.Row="3" 
                Style="{StaticResource SectionBorder}"
                Margin="0,0,0,10">

                <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Left">
                    <TextBlock x:Name="txtResults" 
                               Text="📊 Show 12 Brand found" 
                               FontSize="12" 
                               FontWeight="SemiBold"
                               Foreground="#333333"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="4" 
                    Style="{StaticResource SectionBorder}"
                    Padding="0">
                <ListView x:Name="gridBrands" 
                      Style="{StaticResource ListViewStyle}"
                      ItemsSource="{Binding Product}">

                    <ListView.View>
                        <GridView x:Name="gridCellBrands">
                            <GridViewColumn Header="ID">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource GVBorderTextDefault}">
                                            <TextBlock Text="{Binding IdBrand}"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Product">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource GVBorderText}">
                                            <TextBlock Text="{Binding Products}" />
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Brand">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource GVBorderText}">
                                            <TextBlock Text="{Binding Name}" />
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Price">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource GVBorderCurrency}">
                                            <TextBlock Text="{Binding Price, StringFormat='${0:N2}'}"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Action">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Style="{StaticResource GridButtonPanel}">
                                            <Button Style="{StaticResource GridButtonEdit}"
                                                        Click="btnUpdate_Click"/>
                                            <Button Style="{StaticResource GridButtonRemove}"
                                                        Click="btnRemove_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
            <Border Grid.Row="5"   
                Style="{StaticResource SectionBorder}" >
                <ctrl:PageNavigation 
                x:Name="pageControl"
                PageComboboxChanged ="PageNavigation_SelectionChanged"
                PreviousClick ="PagePrevious_Click"
                NextClick="PageNext_Click"/>
            </Border>
            <Border Grid.Row="6" 
                Style="{StaticResource SectionBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" 
                    Style="{StaticResource ShortButtonStackPanel}">

                        <Button Name="btnNewBrand" 
                            Content="➕ New" 
                            Style="{StaticResource ShortButtonPanel}"        
                            Margin="0,0,0,0"
                            Background="#5069AA"
                            Foreground="White"                    
                            Click="btnNewBrand_Click" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right">
                        <Button Name="btnsClear" 
                            Content="Clear" 
                            Style="{StaticResource ShortButtonPanel}"
                            Click="btnsClear_Click" />

                        <Button Name="btnsClose" 
                            Content="Close" 
                            Style="{StaticResource ShortButtonPanel}"  
                            Margin="5,0,10,0"
                            Click="btnsClose_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <ctrl:Loading x:Name="progress" 
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"        
                      IsLoading="{Binding IsBusy}" 
                      Message="{Binding Message}"/>
    </Grid>
</Window>