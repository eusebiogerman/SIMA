<Window x:Class="SIMA.Presentation.Views.Wstocks"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SIMA.Presentation.Views"
        mc:Ignorable="d"
        Title="Stock Management" Height="388" Width="500"
        Background="#F5F5F5"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Closing="Window_Closing">

    <Window.Resources>
        <!-- Style Shared -->
        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="Titleselection" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2196F3"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Style="{StaticResource SectionBorder}"
                Margin="0,0,0,0">

            <StackPanel Grid.Row="0" 
                    VerticalAlignment="Center">
             
              <TextBlock Text="STOCK MANAGMENT" 
                          Style="{StaticResource Titleselection}"/>


                <Label Content="Category:" FontWeight="SemiBold"/>
                <ComboBox Name="cmbCategory" 
                     Height="35" 
                     Padding="5" 
                     Margin="0,0,0,5" 
                     SelectionChanged="cmbCategory_SelectionChanged"
                     Cursor="Hand"/>

                <Label Content="Product:" FontWeight="SemiBold" BorderThickness="0"/>
                <ComboBox Name="cmbProduct" 
                     Height="35" 
                     Padding="5" 
                     Margin="0,0,0,5"
                     Cursor="Hand" SelectionChanged="cmbProduct_SelectionChanged"/>


                <!-- Stock actual (solo lectura) -->
                <Label Content="Stock :" FontWeight="SemiBold"/>
                <TextBox Name="txtStockActual" 
                     Height="35" 
                     Padding="5" 
                     Margin="0,0,0,2"
                     Background="#F0F0F0"/>
            </StackPanel>

        </Border>

        <Border Grid.Row="1" 
                Style="{StaticResource SectionBorder}" 
                Margin="0,0,0,0">

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="1" 
                    Orientation="Horizontal"
                    VerticalAlignment="Top"
                    Margin="0,0,0,0"
                    Width="auto" 
                    Height="53">

                    <Button Name="btnSaveStock" 
                    Content="✔️ Save" 
                    Width="100" 
                    Height="35"
                    Margin="5,0,5,0"
                    Background="#4CAF50"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand" Click="btnSaveStock_Click"/>

                    <Button Name="btnNewStock" 
                    Content="➕ New" 
                    Width="60" 
                    Height="35"
                    Margin="0,0,70,0"
                    Background="#5069AA"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand" Click="btnNewStock_Click" />

                    <Button Name="btnClear" 
                    Content="Clear" 
                    Width="100" 
                    Height="40"
                    Cursor="Hand"
                    Click="btnClear_Click"/>

                    <Button Name="btnClose" 
                    Content="Close" 
                    Width="100" 
                    Height="40"
                    Margin="5,0,10,0"
                    Cursor="Hand" Click="btnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
            <StackPanel>
                <Ellipse x:Name="wloading" Width="50" Height="50" Stroke="DodgerBlue" StrokeThickness="5" 
         StrokeDashArray="3, 1" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="noFreezeRotate" Angle="0" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="noFreezeRotate"
                                     Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:1"
                                     RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
            </StackPanel>
    </Grid>
</Window>