<Window x:Class="SIMA.Presentation.Views.Wstocks"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:SIMA.Templates"
        mc:Ignorable="d"
        Title="Stock Management" 
        Width="820"
        Height="770"
        Background="#F5F5F5"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Closing="Window_Closing" Loaded="Window_Loaded" Initialized="Window_Initialized">

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Style="{StaticResource SectionBorder}"
                Margin="0,0,0,0">

            <StackPanel Grid.Row="1" >
                <StackPanel >
                    <TextBlock Text="STOCK MANAGMENT" 
                               Style="{StaticResource Titleselection}"
                               TextAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="FormBrand">
                    <StackPanel  Style="{StaticResource PanelFields}">
                        <Label Content="ID:" 
                               Margin="5,0,37,0"
                               Style="{StaticResource LabelFields}"/>
                        <TextBox Name="txtIdStock" 
                             Width="100"
                             Height="25"    
                             Background="#F0F0F0"
                             IsReadOnly="True"/>
                    </StackPanel>
                    <StackPanel  Style="{StaticResource PanelFields}">
                        <Label Content="Product:" 
                               Margin="5,0,6,0"
                               Style="{StaticResource LabelFields}"/>
                        <ComboBox ItemsSource="{Binding Product}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="IdProduct"
                                  x:Name="cmbPropduct" 
                                  Width="300" 
                                  Height="25" 
                                  FontSize="14"
                                  BorderBrush="#CCCCCC"
                                  SelectedIndex="0"
                                  Cursor="Hand" 
                                  SelectionChanged="cmbPropduct_SelectionChanged" />

                        <Label Content="Brand :" 
                               Margin="5,0,0,0"
                               Style="{StaticResource LabelFields}"/>
                        <ComboBox ItemsSource="{Binding Brand}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="IdBrand"
                                  x:Name="cmbBrand" 
                                  Width="300" 
                                  Height="25" 
                                  FontSize="14"
                                  BorderBrush="#CCCCCC"
                                  SelectedIndex="0"
                                  Cursor="Hand" />

                    </StackPanel>

                    <StackPanel  Style="{StaticResource PanelFields}">
                        <Label Content="Stock:" 
                               Margin="5,0,19,0"
                               Style="{StaticResource LabelFields}"/>
                        <TextBox Text="{Binding StockCount, 
                            UpdateSourceTrigger=PropertyChanged, 
                            ValidatesOnNotifyDataErrors=True}" 
                                 Name="txtStock" 
                                 Width="150"
                                 Height="25"    
                                 Background="#F0F0F0">
                            <TextBox.Resources>
                                <ControlTemplate x:Key="NameErrorTemplate">
                                    <StackPanel>
                                        <AdornedElementPlaceholder Name="placeholder"/>
                                        <TextBlock Text="{Binding ElementName=placeholder, 
                                            Path=AdornedElement.(Validation.Errors)[0].ErrorContent}" 
                           Foreground="Red" FontSize="10"/>
                                    </StackPanel>
                                </ControlTemplate>
                            </TextBox.Resources>

                            <Validation.ErrorTemplate>
                                <StaticResource ResourceKey="NameErrorTemplate"/>
                            </Validation.ErrorTemplate>
                        </TextBox>
                        <Button Name="btnsSaveBrand" 
                                Content="&#x1F4BE; Save" 
                                Style="{StaticResource CommunButton}"
                                Background="#377d0c"
                                Foreground="White"
                                Click="btnsSaveBrand_Click" />
                    </StackPanel>

                </StackPanel>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" 
                Style="{StaticResource SectionBorder}" 
                Margin="0,0,0,0">
            <StackPanel Grid.Row="0" 
                                Grid.Column="0"
                                Orientation="Horizontal" Grid.ColumnSpan="4">
                <TextBlock Text="Search:" 
                           FontWeight="SemiBold" 
                           Margin="0,0,29,0"
                           Foreground="#333333"
                           VerticalAlignment="Center"/>


                <TextBox Name="txtSearch" 
                         Width="430"
                         Height="35" 
                         Padding="5" 
                         Background="#F0F0F0" 
                         TextChanged="txtSearch_TextChanged"/>
            </StackPanel>


        </Border>
        <Border Grid.Row="2" 
                    Style="{StaticResource SectionBorder}"
                    Margin="0,0,0,10">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock x:Name="txtResults" 
                               Text="📊 Show 12 Brand found" 
                               FontSize="12" 
                               FontWeight="SemiBold"
                               Foreground="#333333"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="3" 
                    Style="{StaticResource SectionBorder}"
                    Padding="0">
            <ListView x:Name="gridBrands" 
                            Background="Transparent"
                            BorderThickness="0"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            Width="auto"
                            Height="380"  
                            Cursor="Hand"
                            ItemsSource="{Binding StockProducts}"
                            VerticalAlignment="Top">

                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding IdStock}" 
                                                   Margin="10,0" 
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Product" Width="250">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource GVText}">
                                        <TextBlock Text="{Binding Products}" 
                                                       HorizontalAlignment="Center"
                                                       FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Brand" Width="250">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource GVText}">
                                        <TextBlock Text="{Binding Brands}" 
                                                       HorizontalAlignment="Center"
                                                       FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Stock" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource GVNumericBadge}" Width="50">
                                        <TextBlock Text="{Binding Stock}" 
                                                    Foreground="White" 
                                                    FontWeight="Bold"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Acciones" Width="auto">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Style="{StaticResource GridButtonPanel}">
                                        <Button Style="{StaticResource GridButtonEdit}"
                                                        Click="btnUpdate_Click"/>
                                        <Button Style="{StaticResource GridButtonRemove}"
                                                        Click="btnRemove_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
        <Border Grid.Row="4" >
            <ctrl:PageNavigation 
                x:Name="pageControl"
                PageComboboxChanged ="PageNavigation_SelectionChanged"
                PreviousClick ="PagePrevious_Click"
                NextClick="PageNext_Click"/>
        </Border>
        <Border Grid.Row="5" 
                Style="{StaticResource SectionBorder}" 
                Margin="0,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" 
                    Style="{StaticResource ShortButtonStackPanel}">

                    <Button Name="btnNewBrand" 
                            Content="➕ New" 
                            Style="{StaticResource ShortButtonPanel}"        
                            Margin="0,0,0,0"
                            Background="#5069AA"
                            Foreground="White"                    
                            Click="btnNewBrand_Click" />
                </StackPanel>

                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right">
                    <Button Name="btnsClear" 
                            Content="Clear" 
                            Style="{StaticResource ShortButtonPanel}"
                            Click="btnsClear_Click" />

                    <Button Name="btnsClose" 
                            Content="Close" 
                            Style="{StaticResource ShortButtonPanel}"  
                            Margin="5,0,10,0"
                            Click="btnsClose_Click" />
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel>
            <Ellipse x:Name="wloading" Width="50" Height="50" Stroke="DodgerBlue" StrokeThickness="5" 
         StrokeDashArray="3, 1" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="noFreezeRotate" Angle="0" />
                </Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="noFreezeRotate"
                                     Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:1"
                                     RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
        </StackPanel>
    </Grid>
</Window>