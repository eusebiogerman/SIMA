<Window x:Class="SIMA.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:ctrl="clr-namespace:SIMA.Templates"
        xmlns:local="clr-namespace:SIMA.Presentation.ViewModel"
        mc:Ignorable="d"
        Title="Simple Inventory Management App(SIMA)" 
        Height="Auto" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        Loaded="Window_Loaded" 
        Initialized="Window_Initialized" 
        SizeChanged="Window_SizeChanged" 
        WindowState="Maximized" 
        ContentRendered="Window_ContentRendered">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="94*"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90*"/>
                <ColumnDefinition Width="10*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"></Border>
            <Border Grid.Column="1"
                     Style="{StaticResource SectionBorder}">
                    <TextBlock x:Name="txbusername" 
                               FontWeight="Bold"
                               FontSize="12"
                               Style="{StaticResource TitleStyle}"
                               Text="username"
                               HorizontalAlignment="Right"/>
            </Border>
        </Grid>
        <Border Grid.Column="0" 
                Grid.Row="1"
                Background="#1E1E1C" 
                Padding="15" 
                Margin="0,0,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,1,0,4">
                    <TextBlock Text="Simple Inventory Management App(SIMA)" 
                               Foreground="White" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"/>
                    <Separator Margin="10,15" Background="#333"/>
                </StackPanel>
                    <Grid DockPanel.Dock="Top"
                          Margin="0,1,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>

                   <StackPanel Grid.Column="0" 
                               Orientation="Horizontal"
                               HorizontalAlignment="Left">
                       <Button Content="&#x25B2;"
                               HorizontalAlignment="Left"
                               Style="{StaticResource TreeButton}"
                               Tag="All"
                               Click="btnCollapse_Click" />
                       <Button Content="&#x25B2;&#x25B4;" 
                               HorizontalAlignment="Left"
                               Style="{StaticResource TreeButton}"
                               Tag="Current"
                               Click="btnCollapse_Click" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" 
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="&#x25BC;&#x25BE;" 
                                HorizontalAlignment="Right"
                                Style="{StaticResource TreeButton}"
                                Tag="All"
                                Click="btnExpand_Click" />
                        <Button Content="&#x25BC;"
                                HorizontalAlignment="Right"
                                Style="{StaticResource TreeButton}"
                                Tag="Current"
                                Click="btnExpand_Click" />
                    </StackPanel>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TreeView ItemsSource="{Binding MenuTree}" 
                              Background="Transparent" 
                              Cursor="Hand" 
                              BorderThickness="0"
                              SelectedItemChanged="tree_SelectionCurrent"
                              MouseDoubleClick="tree_OpenSelection">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type local:MenuItems}"
                                                      ItemsSource="{Binding Items}">
                                    <StackPanel Orientation="Horizontal"
                                            Style="{StaticResource MenuPanelStyle}" 
                                            Tag="{Binding ItemMenu.AppName }">
                                    <TextBlock Text="{Binding ItemMenu.IconClass}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding ItemMenu.AppName}"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="1" 
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" 
                            Style="{StaticResource SectionBorder}"
                            Margin="0,0,0,15">

                        <StackPanel>
                            <TextBlock Text="🔍 FILTER PRODUCTS" 
                          Style="{StaticResource Titleselection}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" 
                                Grid.Column="0"
                                Orientation="Horizontal">
                                    <TextBlock Text="Category:" 
                                               FontWeight="SemiBold" 
                                               Margin="5,0,7,0"
                                               Foreground="#333333"/>
                                    <ctrl:LovTextBox x:Name="cmbCategory"
                                                     ItemsSource="{Binding Category}"
                                                     DisplayMemberPath="Value"
                                                     SelectedValuePath="Id"
                                                     SelectedIndex="0"
                                                     Width="300" 
                                                     Height="25" 
                                                     FontSize="14"
                                                     BorderBrush="#CCCCCC"
                                                     LovTextBoxChanged ="cmbCategory_SelectionChanged"/>

                                </StackPanel>
                                <StackPanel Grid.Row="1" 
                                Grid.Column="0" 
                                Orientation="Horizontal"
                                Grid.ColumnSpan="4" 
                                Margin="5,5,0,0">
                                    <TextBlock Text="Product:" 
                                   FontWeight="SemiBold" 
                                   Margin="0,0,15,0"
                                   Foreground="#333333"/>

                                    <TextBox x:Name="txtSearch"
                                 Height="35" 
                                 Width="400"
                                 FontSize="14"
                                 Padding="10,5"
                                 BorderBrush="#CCCCCC" TextChanged="txtSearch_TextChanged"/>

                                    <Button x:Name="btnClear"
                                            Style="{StaticResource CommunButton}"
                                            Content="🗑 Clear" 
                                            Background="#FF5722" 
                                            Foreground="White" 
                                            Cursor="Hand" 
                                            Click="btnClear_Click"/>

                                    <Button x:Name="btnRefresh" 
                                            Style="{StaticResource CommunButton}"
                                            Content="&#x1F504; Refresh"
                                            Background="#2531DB"
                                            Foreground="#F2F2F2"                                
                                            Cursor="Hand" 
                                            Click="btnRefresh_Click" />

                                </StackPanel>
                                <StackPanel Grid.Row="2" 
                                Grid.Column="0" 
                                Grid.ColumnSpan="4" 
                                Orientation="Horizontal">

                                    <Border x:Name="filterCatTag" 
                                Background="#E3F2FD" 
                                CornerRadius="15" 
                                Padding="10,3" 
                                Margin="0,0,5,0"
                                Visibility="Collapsed">
                                        <TextBlock x:Name="txtFiltroCategoria" 
                                       Foreground="#2196F3"
                                       FontSize="12"/>
                                    </Border>

                                    <Border x:Name="FilterProductTag" 
                                Background="#E3F2FD" 
                                CornerRadius="15" 
                                Padding="10,3" 
                                Margin="5,0,0,0"
                                Visibility="Collapsed">
                                        <TextBlock x:Name="txtSearchProduct" 
                                       Foreground="#2196F3"
                                       FontSize="12"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" 
                                Style="{StaticResource SectionBorder}"
                                Margin="0,0,0,5">

                        <StackPanel Orientation="Horizontal" 
                                        HorizontalAlignment="Left">
                            <TextBlock x:Name="txtResults" 
                                           Text="📊 Show 12 products found" 
                                           FontSize="12" 
                                           FontWeight="SemiBold"
                                           Foreground="#333333"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" 
                                Style="{StaticResource SectionBorder}"
                                Padding="0">
                        <ListView x:Name="gridProducts"
                                      Style="{StaticResource ListViewStyle}"
                                      ItemsSource="{Binding StockProducts}">
                            <ListView.View>
                                <GridView x:Name="gridCellProduct">
                                    <GridViewColumn Header="ID">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource GVBorderTextDefault}">
                                                    <TextBlock Text="{Binding IdStock}"/>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Category">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource GVBorderText}">
                                                    <TextBlock Text="{Binding Categorys}"/>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Product">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource GVBorderText}">
                                                    <TextBlock Text="{Binding Products}"/>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Brand">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource GVBorderText}">
                                                    <TextBlock Text="{Binding Brands}" />
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Price">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource GVBorderCurrency}">
                                                    <TextBlock Text="{Binding Price, StringFormat='${0:N2}'}"/>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Stock">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource GVNumericBadge}">
                                                    <TextBlock Text="{Binding Stock}"/>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Acciones">
                                        <GridViewColumn.CellTemplate >
                                            <DataTemplate>
                                                <StackPanel Style="{StaticResource GridButtonPanel}">
                                                    <Button Style="{StaticResource GridButtonEdit}"
                                                                Click="btnUpdate_Click"/>
                                                    <Button Style="{StaticResource GridButtonRemove}"
                                                                Click="btnRemove_Click"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                    <Border Grid.Row="3" 
                                Style="{StaticResource SectionBorder}">
                        <ctrl:PageNavigation 
                                x:Name="pageControl"
                                PageComboboxChanged ="PageNavigation_SelectionChanged"
                                PreviousClick ="PagePrevious_Click"
                                NextClick="PageNext_Click"/>
                    </Border>
                    <Border Grid.Row="4" 
                                Style="{StaticResource SectionBorder}">
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="1" 
                                            Style="{StaticResource ShortButtonStackPanel}"
                                            HorizontalAlignment="Right">

                                <Button Name="btnsClose"
                                            Content="Close" 
                                            Style="{StaticResource ShortButtonPanel}"
                                            Margin="5,0,10,0"
                                            Click="btnClose_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
        <Grid Grid.Row="2" Grid.ColumnSpan="2" >
            <ctrl:StatusbarLoading 
                x:Name="statusbox" 
                Height="auto"
                IsLoading="{Binding IsBusy}"
                Message="{Binding Message}"
                Color="{Binding Color}"/>
        </Grid>
    </Grid>
    
</Window>