<Window x:Class="SIMA.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="INVENTARIO DE PRODUCTOS" 
        Height="700" 
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <!-- Estilos compartidos -->
        <Style x:Key="SeccionBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="TituloSeccion" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2196F3"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <!-- CONTENEDOR PRINCIPAL CON 3 FILAS -->
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- TOP SECTION: Filtros -->
            <RowDefinition Height="Auto"/>

            <!-- MAIN SECTION: Grid + Contador -->
            <RowDefinition Height="*"/>

            <!-- BOTTOM SECTION: Botones de acción -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========================================= -->
        <!-- TOP SECTION: PANEL DE FILTROS            -->
        <!-- ========================================= -->
        <Border Grid.Row="0" 
                Style="{StaticResource SeccionBorder}"
                Margin="0,0,0,15">

            <StackPanel>
                <!-- Título de la sección -->
                <TextBlock Text="🔍 FILTROS DE BÚSQUEDA" 
                          Style="{StaticResource TituloSeccion}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Fila 1: Categoría + Botones principales -->

                    <!-- Categoría ComboBox -->
                    <StackPanel Grid.Row="0" 
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,0">
                        <TextBlock Text="Categoría:" 
                                   FontWeight="SemiBold" 
                                   Margin="0,0,25,0"
                                   Foreground="#333333"/>

                        <ComboBox x:Name="cmbCategoria" 
                                  Width="300" 
                                  Height="35" 
                                  FontSize="14"
                                  BorderBrush="#CCCCCC"
                                  SelectedIndex="0"
                                  Cursor="Hand"/>
                    </StackPanel>


                    <!-- Fila 2: Descripción -->
                    <StackPanel Grid.Row="1" 
                                Grid.Column="0" 
                                Orientation="Horizontal"
                                Grid.ColumnSpan="2" 
                                Margin="0,5,0,0">
                        <TextBlock Text="Descripción:" 
                                   FontWeight="SemiBold" 
                                   Margin="0,0,15,0"
                                   Foreground="#333333"/>

                        <TextBox x:Name="txtDescripcion" 
                                 Height="35" 
                                 Width="400"
                                 FontSize="14"
                                 Padding="10,5"
                                 BorderBrush="#CCCCCC"/>
                        
                        <Button x:Name="btnBuscar" 
                                Content="🔍 Buscar" 
                                Width="100" 
                                Height="35" 
                                Margin="5,0" 
                                Background="#2196F3" 
                                Foreground="White" 
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"/>

                        <Button x:Name="btnLimpiar" 
                                Content="🗑 Limpiar" 
                                Width="100" 
                                Height="35" 
                                Background="#FF5722" 
                                Foreground="White" 
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"/>

                    </StackPanel>

                    <!-- Fila 3: Filtros activos (tags) -->
                    <StackPanel Grid.Row="2" 
                                Grid.Column="0" 
                                Grid.ColumnSpan="2" 
                                Orientation="Horizontal">

                        <!-- Tag Categoría -->
                        <Border x:Name="FiltroCategoriaTag" 
                                Background="#E3F2FD" 
                                CornerRadius="15" 
                                Padding="10,3" 
                                Margin="0,0,5,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="txtFiltroCategoria" 
                                       Foreground="#2196F3"
                                       FontSize="12"/>
                        </Border>

                        <!-- Tag Descripción -->
                        <Border x:Name="FiltroDescripcionTag" 
                                Background="#E3F2FD" 
                                CornerRadius="15" 
                                Padding="10,3" 
                                Margin="5,0,0,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="txtFiltroDescripcion" 
                                       Foreground="#2196F3"
                                       FontSize="12"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ========================================= -->
        <!-- MAIN SECTION: GRID DE PRODUCTOS          -->
        <!-- ========================================= -->
        <Grid Grid.Row="1" Margin="0,0,0,0" >

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CONTADOR DE RESULTADOS -->
            <Border Grid.Row="0" 
                    Style="{StaticResource SeccionBorder}"
                    Margin="0,0,0,10">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock x:Name="txtResultados" 
                               Text="📊 Mostrando 12 productos encontrados" 
                               FontSize="12" 
                               FontWeight="SemiBold"
                               Foreground="#333333"/>
                </StackPanel>
            </Border>

            
            <!-- GRIDVIEW DE PRODUCTOS -->
            <Border Grid.Row="1" 
                    Style="{StaticResource SeccionBorder}"
                    Padding="0">
                

                <ListView x:Name="gridProducts" 
                          Background="Transparent"
                          BorderThickness="0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Width="auto" >


                    <ListView.View>
                        <GridView>
                            <!-- Columna ID -->
                            <GridViewColumn Header="ID" Width="60">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding IdStock}" 
                                                   Margin="10,0" 
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Columna Nombre -->
                            <GridViewColumn Header="Product" Width="400">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="5">
                                            <TextBlock Text="{Binding Icono}" 
                                                       FontSize="16" 
                                                       Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Name}" 
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Columna Categoría -->
                            <GridViewColumn Header="Category" Width="270">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#E0E0E0" 
                                                CornerRadius="12" 
                                                Padding="8,3"
                                                Margin="5"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" 
                                                       HorizontalAlignment="Center"
                                                       FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Columna Precio -->
                            <GridViewColumn Header="Price" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Price, StringFormat='${0:N2}'}" 
                                                   Margin="10,0" 
                                                   FontWeight="Bold"
                                                   Foreground="#2196F3"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Columna Stock -->
                            <GridViewColumn Header="Stock" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#4CAF50"
                                                Width="50"
                                                Height="25"
                                                CornerRadius="4"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Stock}" 
                                                       Foreground="White" 
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Columna Acciones -->
                            <GridViewColumn Header="Acciones" Width="auto">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" 
                                                    HorizontalAlignment="Center"
                                                    Margin="0,5">
                                            <Button Content="✎" 
                                                    Width="30" Height="30"
                                                    Background="#2196F3"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    Cursor="Hand"/>
                                            <Button Content="🗑" 
                                                    Width="30" Height="30"
                                                    Background="#F44336"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Grid>

        <!-- ========================================= -->
        <!-- BOTTOM SECTION: BOTONES DE ACCIÓN        -->
        <!-- ========================================= -->
        <Border Grid.Row="2" 
                Style="{StaticResource SeccionBorder}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Navegación -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="📌 ACCIONES" 
                              Style="{StaticResource TituloSeccion}"
                              Margin="0,0,20,0"
                              VerticalAlignment="Center"/>

                    <Button x:Name="btnAnterior" 
                            Content="← Anterior" 
                            Width="100" 
                            Height="35"
                            Margin="0,0,10,0"
                            Background="White"
                            Foreground="#333333"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            Cursor="Hand"/>

                    <TextBlock x:Name="txtPaginacion" 
                               Text="Página 1 de 5" 
                               VerticalAlignment="Center"
                               Margin="10,0"
                               Foreground="#666666"/>

                    <Button x:Name="btnSiguiente" 
                            Content="Siguiente →" 
                            Width="100" 
                            Height="35"
                            Margin="10,0,0,0"
                            Background="White"
                            Foreground="#333333"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            Cursor="Hand"/>
                </StackPanel>

                <!-- RIGHT: Acciones principales -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Items por página:" 
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Foreground="#666666"/>

                    <ComboBox x:Name="cmbItemsPorPagina" 
                              Width="80" 
                              Height="35"
                              BorderBrush="#CCCCCC"
                              SelectedIndex="0">
                        <ComboBoxItem Content="12"/>
                        <ComboBoxItem Content="24"/>
                        <ComboBoxItem Content="48"/>
                        <ComboBoxItem Content="96"/>
                    </ComboBox>

                    <Button x:Name="btnNuevoProducto" 
                            Content="➕ Nuevo Producto" 
                            Width="150" 
                            Height="35"
                            Margin="20,0,0,0"
                            Background="#4CAF50"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"/>

                    <Button x:Name="btnExportar" 
                            Content="📥 Exportar" 
                            Width="100" 
                            Height="35"
                            Margin="10,0,0,0"
                            Background="#FF9800"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>