<Window x:Class="SIMA.Presentation.WLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SIMA.Presentation"
        xmlns:ctrl="clr-namespace:WpfJEG.net6;assembly=WpfJEG"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="WLogin" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30*"/>
            <ColumnDefinition Width="70*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Column="0"  
                Background="#f7f7f7"
                BorderThickness="1"
                BorderBrush="DarkSlateGray"
                CornerRadius="10.2">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="70*"/>
                    <RowDefinition Height="5*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0">
                    <Label HorizontalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="11"
                       Foreground="#FF5722">
                        <Label.Content>Simple Inventory Management App(SIMA)</Label.Content>
                    </Label>
                </Border>
                <Border Grid.Row="1" Padding="5">
                    <StackPanel>
                        <TextBlock Text="SIMA is a specialized inventory and stock management module integrated within the ccbudgetwpf project. It is designed to provide high-performance data handling and a modern desktop user interface for managing retail or warehouse products."
                                   TextWrapping="Wrap"
                                   Width="auto"/>
                        <TextBlock Text="Key Functionalities"
                                       Style="{StaticResource LoginH1}"
                                       Margin="0,5,0,5"
                                       Width="auto"/>
                        <TextBlock LineHeight="20" TextWrapping="Wrap">
                        <Run Text="&#x2022;"/> <Run Foreground="#2196F3" FontWeight="Bold" Text="Stock and Brand Synchronization:"/><LineBreak/>
                        <Run Text="Robust logic to ensure that product stock levels remain consistent across the database."/><LineBreak/>
                        <Run Text="&#x2022;"/> <Run Foreground="#2196F3" FontWeight="Bold" Text="Database Integration:"/><LineBreak/>
                        <Run Text="Optimized for SQL-based environments, ensuring that inventory data is persistent and scalable."/><LineBreak/>
                        <Run Text="&#x2022;"/> <Run Foreground="#2196F3" FontWeight="Bold" Text="Advanced UI Components:"/>
                        <Run Text="The interface is designed for professional featuring multi-line status bars for real-time feedback" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2">
                    <ctrl:Loading x:Name="progress" 
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Column="1" Grid.Row="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="30*"/>
                </Grid.RowDefinitions>
                <Border Grid.Column="1" 
                        Grid.Row="0" 
                        Background="#f7f7f7"
                        BorderThickness="1"
                        Margin="5"
                        BorderBrush="DarkSlateGray"
                        CornerRadius="10.2">

                    <Image Source="pack://application:,,,/SIMA;component/Presentation/Resources/Images/logo.png" />
                </Border>
                <Border Grid.Row="1">
                    <StackPanel Style="{StaticResource PanelFields}"
                                HorizontalAlignment="Center">
                        <Label Content="User Name:" 
                               Margin="5,15,7,15"
                               Style="{StaticResource LabelFields}"/>
                        <TextBox Name="txtUserName" 
                                 Width="250"
                                 Height="35"   
                                 Background="#F0F0F0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2">
                    <StackPanel Style="{StaticResource PanelFields}"
                                HorizontalAlignment="Center">
                        <Label Content="Password:" 
                               Margin="5,15,13,15"
                               Style="{StaticResource LabelFields}"/>
                        <PasswordBox Name="txtPass" 
                                 Width="250"
                                 Height="35"   
                                 Background="#F0F0F0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="3" Padding="10">
                    <StackPanel  
                    Style="{StaticResource ShortButtonStackPanel}"
                    HorizontalAlignment="Center">
                        <Button Name="btnsClose" 
                            Content="Cancel" 
                            Style="{StaticResource ShortButtonPanel}" 
                            Margin="0,0,45,0"
                            Click="btnsClose_Click" />

                        <Button Name="btnLogin" 
                            Content="Login" 
                            Style="{StaticResource ShortButtonPanel}"        
                            Background="#5069AA"
                            Foreground="White"                    
                            Click="btnLogin_Click" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="4">
                    <StackPanel HorizontalAlignment="Center">
                    <Image Width="70"  Source="pack://application:,,,/SIMA;component/Presentation/Resources/Images/microsoft.jpg"/>
                        <TextBlock>
                        <Hyperlink RequestNavigate="LinkClick_azureLogin">Login with Azure</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
