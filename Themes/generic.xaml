<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:SIMA.Templates">

    <Style x:Key="PageNavigationButton" TargetType="Button">
        <Setter Property="Width" Value="50"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="5,0,0,0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#333333"/>
        <Setter Property="BorderBrush" Value="#CCCCCC"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="PageNavigationText" TargetType="TextBlock">
        <Setter Property="Margin" Value="10,0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#666666"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PageTitleselection" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#2196F3"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PageComboBox" TargetType="ComboBox">
        <Setter Property="Width" Value="80"/>
        <Setter Property="Height" Value="35"/>
        <Setter Property="BorderBrush" Value="#CCCCCC"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SelectedIndex" Value="0"/>
    </Style>

    
    <!--Paging Custom Control-->
    <Style TargetType="{x:Type local:PageNavigation}">
    <Setter Property="Template">
        <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PageNavigation}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left side -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="📌 PAGINATION"
                                   Style="{StaticResource PageTitleselection}"
                                   VerticalAlignment="Center"/>

                        <Button Content="←"
                                x:Name="PART_PagePreviousButton"
                                Style="{StaticResource PageNavigationButton}"
                                FontSize="25"
                                Command="{TemplateBinding PreviousCommand}"/>

                        <TextBlock Text="{Binding PageNumber, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="Hidden"/>

                        <TextBlock Text="{Binding TotalPages, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="Hidden"/>

                        <TextBlock Text="{Binding PageNumber, RelativeSource={RelativeSource TemplatedParent}, StringFormat=Page {0}}"
                                   Style="{StaticResource PageNavigationText}"/>

                        <TextBlock Text="{Binding TotalPages, RelativeSource={RelativeSource TemplatedParent}, StringFormat= of {0}}"
                                   Style="{StaticResource PageNavigationText}"/>

                        <Button Content="→"
                                x:Name="PART_PageNextButton"
                                Style="{StaticResource PageNavigationButton}"
                                FontSize="25"
                                Command="{TemplateBinding NextCommand}"/>
                    </StackPanel>

                    <!-- Right side -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,0,15,0">

                        <TextBlock Text="Items per page:"
                                   Style="{StaticResource PageNavigationText}"/>

                            <ComboBox x:Name="PART_PageComboBox"
                                  ItemsSource="{TemplateBinding ItemsPerPageSource}"
                                  SelectedItem="{Binding ItemsPerPage, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                  Style="{StaticResource PageComboBox}">
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

    
    <!--PopupLOV Custom Control-->
    <Style TargetType="{x:Type local:LovTextBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:LovTextBox}">
                    <Grid>
                        <TextBox x:Name="PART_TextBox"
                             Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />

                        <Popup x:Name="PART_Popup"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           Focusable="False">
                            <Border Background="White" BorderBrush="Gray" BorderThickness="1">
                                <ListBox x:Name="PART_ListBox"
                                     ItemsSource="{TemplateBinding ItemsSource}"
                                     SelectedItem="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
