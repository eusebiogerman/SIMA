
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:help="clr-namespace:SIMA.Helper"
    xmlns:local="clr-namespace:SIMA.Templates">


    <Style x:Key="TriggeringStyle" TargetType="Button">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#2a2a28"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <Style x:Key="PageNavigationButton" TargetType="Button" BasedOn="{StaticResource TriggeringStyle}" >
        <Setter Property="Width" Value="50"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="5,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderBrush" Value="#CCCCCC"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="TextBlock.Width" Value="50"/>
        <Setter Property="TextBlock.Height" Value="auto"/>
        <Setter Property="TextBlock.FontWeight" Value="SemiBold"/>
        <Setter Property="TextBlock.Foreground" Value="#333333"/>
        <Setter Property="TextBlock.TextAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PageNavigationText" TargetType="TextBlock">
        <Setter Property="Margin" Value="10,0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#666666"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PageTitleselection" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#2196F3"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PageComboBox" TargetType="ComboBox">
        <Setter Property="Width" Value="80"/>
        <Setter Property="Height" Value="35"/>
        <Setter Property="BorderBrush" Value="#CCCCCC"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SelectedIndex" Value="0"/>
    </Style>


    <!--Paging Custom Control-->
    <Style TargetType="{x:Type local:PageNavigation}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PageNavigation}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left side -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="📌 PAGINATION"
                                   Style="{StaticResource PageTitleselection}"
                                   VerticalAlignment="Center"/>

                            <Button x:Name="PART_PagePreviousButton"
                                    Style="{StaticResource PageNavigationButton}" 
                                    FontSize="25"
                                Command="{TemplateBinding PreviousCommand}">
                                <TextBlock Text="←"/>
                            </Button>

                            <TextBlock Text="{Binding PageNumber, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="Hidden"/>

                            <TextBlock Text="{Binding TotalPages, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="Hidden"/>

                            <TextBlock Text="{Binding PageNumber, RelativeSource={RelativeSource TemplatedParent}, StringFormat=Page {0}}"
                                   Style="{StaticResource PageNavigationText}"/>

                            <TextBlock Text="{Binding TotalPages, RelativeSource={RelativeSource TemplatedParent}, StringFormat= of {0}}"
                                   Style="{StaticResource PageNavigationText}"/>

                            <Button Content="→"
                                x:Name="PART_PageNextButton"
                                Style="{StaticResource PageNavigationButton}"
                                FontSize="25"
                                Command="{TemplateBinding NextCommand}"/>
                        </StackPanel>

                        <!-- Right side -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,0,15,0">

                            <TextBlock Text="Items per page:"
                                   Style="{StaticResource PageNavigationText}"/>

                            <ComboBox x:Name="PART_PageComboBox"
                                  ItemsSource="{TemplateBinding ItemsPerPageSource}"
                                  SelectedItem="{Binding ItemsPerPage, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                  Style="{StaticResource PageComboBox}">
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--PopupLOV Custom Control-->
    <Style TargetType="{x:Type local:LovTextBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:LovTextBox}">
                    <Grid>
                        <TextBox x:Name="PART_TextBox" 
                                 Background="#E0E0E0" 
                                 BorderBrush="Gray" 
                                 BorderThickness="1"
                                 Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />

                        <Popup x:Name="PART_Popup"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           Focusable="False">
                            <Border Background="#E0E0E0" BorderBrush="Gray" BorderThickness="1">
                                <ListBox x:Name="PART_ListBox"
                                     ItemsSource="{TemplateBinding ItemsSource}"
                                     DisplayMemberPath="{TemplateBinding DisplayMemberPath}"
                                     SelectedValuePath="{TemplateBinding SelectedValuePath}"
                                     SelectedItem="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                     SelectedIndex="{TemplateBinding SelectedIndex}"
                                     Cursor="Hand"/>
                            </Border>
                        </Popup>
                        <StackPanel HorizontalAlignment="Right" >
                            <Button x:Name="PART_Button"
                                    Content="▼"
                                    Foreground="DarkGray"
                                    VerticalContentAlignment="Top"
                                    Cursor="Hand"/>
                        </StackPanel>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--Popup Loading Control-->
    <help:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    <Style TargetType="{x:Type local:Loading}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Loading}">
                        <Popup x:Name="PART_Popup"
                               Placement="Center"
                               AllowsTransparency="True"
                               StaysOpen="False">
                            <Border Background="Transparent">
                                <StackPanel>
                                    <TextBlock Text="{TemplateBinding Message}"
                                               Foreground="DodgerBlue"/>
                                    <Ellipse x:Name="PART_Ellipse" 
                                         Width="50" 
                                         Height="50"                                  
                                         Stroke="DodgerBlue" 
                                         StrokeThickness="5" 
                                         StrokeDashArray="3, 1" 
                                         RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="noFreezeRotate" Angle="0" />
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="noFreezeRotate"
                                                                         Storyboard.TargetProperty="Angle"
                                                                         From="0" To="360" 
                                                                         Duration="0:0:1"
                                                                         RepeatBehavior="Forever" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                </StackPanel>
                            </Border>
                        </Popup>
                     </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
