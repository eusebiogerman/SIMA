<Application x:Class="SIMA.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SIMA"
             StartupUri="/Presentation/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Controls/Buttons.xaml"/>
                <ResourceDictionary Source="Styles/Controls/TextBlocks.xaml"/>
                <ResourceDictionary Source="Styles/Controls/StackPanels.xaml"/>
                <ResourceDictionary Source="Styles/Controls/Borders.xaml"/>
                <ResourceDictionary Source="Styles/Controls/Labels.xaml"/>
                <ResourceDictionary Source="Styles/Controls/ComboBoxs.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>

